# ==============================================================================
# RepoMentor AI - Root Environment Example
# Copy this file to .env (or configure in apps/web/.env.local and services/api/.env)
# ==============================================================================

# --- API Backend Service ---
API_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=true
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Frontend Web Application ---
NEXT_PUBLIC_APP_NAME="RepoMentor AI"
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- GitHub Integration (Phase 2+) ---
# Optional: Personal Access Token for higher GitHub REST API rate limits (60/hr -> 5000/hr)
# GITHUB_TOKEN=ghp_exampleSafePlaceholderDoNotCommitActualTokens

# --- AI & LLM Inference (Phase 4+) ---
# Mode options: mock | ollama | openai
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama:7b
# OPENAI_API_KEY=sk-placeholder-for-optional-cloud-models

# --- Speech & Voice Generation (Phase 6+) ---
TTS_PROVIDER=mock
